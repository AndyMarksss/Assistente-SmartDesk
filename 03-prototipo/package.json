{
  "name": "smartdesk",
  "version": "0.8.11",
  "private": true,
  "description": "Assistente guiado de suporte de TI",
  "scripts": {
    "start": "node server/server.cjs",
    "test": "node server/tests/run.cjs",
    "format": "prettier --write \"assets/**/*.{js,css}\" \"server/**/*.cjs\" index.html admin.html",
    "format:check": "prettier --check \"assets/**/*.{js,css}\" \"server/**/*.cjs\" index.html admin.html"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
