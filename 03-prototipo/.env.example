# Cole a chave somente no arquivo .env local. Não envie em prints ou mensagens.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Recebimento pelo Apps Script (URL /exec e token apenas no servidor)
SMARTDESK_APPS_SCRIPT_URL=
SMARTDESK_APPS_SCRIPT_TOKEN=

# Hospedagem HTTPS: Render fornece RENDER_EXTERNAL_URL automaticamente.
# Em outro provedor, configure SMARTDESK_PUBLIC_ORIGIN=https://seu-dominio
# Nunca coloque esta senha ou as chaves no GitHub Pages.
SMARTDESK_ACCESS_USER=avaliador
SMARTDESK_ACCESS_PASSWORD=
